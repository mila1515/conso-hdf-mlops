# =====================================================================
#  Configuration du projet – copiez ce fichier en `.env` puis adaptez.
#  Aucune clé API n'est nécessaire : éCO2mix (RTE/ODRÉ) et Open-Meteo
#  sont des API publiques et gratuites.
# =====================================================================

# --- Données éCO2mix ---
REGION=Hauts-de-France
# Début de l'historique utilisé pour l'entraînement (données dispo depuis 2013)
HISTORY_START=2019-01-01
ODRE_BASE_URL=https://odre.opendatasoft.com/api/explore/v2.1/catalog/datasets
DATASET_CONSOLIDATED=eco2mix-regional-cons-def
DATASET_REALTIME=eco2mix-regional-tr

# --- Météo (Open-Meteo) : coordonnées de Lille ---
USE_WEATHER=true
LATITUDE=50.63
LONGITUDE=3.06

# --- Modèle ---
FORECAST_HORIZON=24
TEST_DAYS=30
MODEL_NAME=conso-hdf-xgboost

# --- MLflow ---
# En local : base SQLite. Avec docker compose : http://mlflow:5000
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=conso-hdf
# Dossier des artefacts MLflow en suivi local (ignoré avec un serveur MLflow distant)
MLFLOW_ARTIFACTS_DIR=mlartifacts

# --- Monitoring & alertes ---
MAPE_ALERT_THRESHOLD=5.0
DRIFT_SHARE_THRESHOLD=0.5
# Distance de Wasserstein normalisée au-delà de laquelle une variable est « en dérive »
WASSERSTEIN_THRESHOLD=0.5
MONITORING_DAYS=7
# Webhook Discord / Slack / Teams (optionnel, laisser vide pour désactiver)
ALERT_WEBHOOK_URL=
# Âge maximal (heures) de la dernière donnée de consommation avant alerte « données obsolètes »
# (et refus de servir une prévision par l'API)
MAX_DATA_AGE_HOURS=36
# Nombre de rapports Evidently HTML conservés
REPORTS_KEEP=30

# --- Chemins ---
DATA_DIR=data
ARTIFACTS_DIR=artifacts
REPORTS_DIR=reports

# --- Planificateur (docker compose, service `scheduler`) ---
SCHEDULE_HOUR_UTC=6

# --- API ---
API_URL=http://localhost:8000
